@page "/Account/Login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@model LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — AprilCraft</title>
    <link href="https://fonts.googleapis.com/css2?family=Kaushan+Script&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/aprilcraft.css" />
</head>
<body class="ac-login-body">
    <div class="ac-login-card">
        <div class="ac-login-logo">
            <span class="ac-brand-script">AprilCraft</span>
            <p class="ac-login-sub">Admin Portal</p>
        </div>
        <form method="post" asp-page="/Account/Login">
            <div asp-validation-summary="ModelOnly" class="ac-form-error"></div>
            <div class="ac-form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="ac-input" placeholder="admin@aprilcraft.cm" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="ac-field-error"></span>
            </div>
            <div class="ac-form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" class="ac-input" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="ac-field-error"></span>
            </div>
            <div class="ac-form-group ac-checkbox-row">
                <input asp-for="Input.RememberMe" type="checkbox" id="rememberMe" />
                <label for="rememberMe">Remember me</label>
            </div>
            <button type="submit" class="ac-btn ac-btn-primary ac-btn-full">Sign In</button>
        </form>
        <a href="/" class="ac-back-link">← Back to site</a>
    </div>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
