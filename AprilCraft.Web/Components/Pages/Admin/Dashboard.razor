@page "/admin"
@layout AdminLayout
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDesignService DesignService
@inject ICategoryService CategoryService

<PageTitle>Dashboard — AprilCraft Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Dashboard</MudText>

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="ac-stat-card" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Palette" Color="Color.Primary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_totalDesigns</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">Total Designs</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="ac-stat-card" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_featuredCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">Featured</MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="ac-stat-card" Elevation="2">
            <MudIcon Icon="@Icons.Material.Filled.Category" Color="Color.Secondary" Size="Size.Large" />
            <div>
                <MudText Typo="Typo.h4">@_categoryCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Default">Categories</MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.h5" Class="mt-8 mb-4">Recent Designs</MudText>
<MudTable Items="_recent" Hover="true" Dense="true" Striped="true">
    <HeaderContent>
        <MudTh>Title</MudTh>
        <MudTh>Category</MudTh>
        <MudTh>Client</MudTh>
        <MudTh>Date</MudTh>
        <MudTh>Featured</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Title</MudTd>
        <MudTd>@context.Category?.Name</MudTd>
        <MudTd>@context.ClientName</MudTd>
        <MudTd>@context.DesignDate.ToString("dd MMM yyyy")</MudTd>
        <MudTd>
            @if (context.IsFeatured)
            {
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" />
            }
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           Href="@($"/admin/designs/{context.Id}")" />
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private int _totalDesigns;
    private int _featuredCount;
    private int _categoryCount;
    private List<Design> _recent = new();

    protected override async Task OnInitializedAsync()
    {
        _totalDesigns = await DesignService.GetTotalCountAsync();
        _featuredCount = await DesignService.GetFeaturedCountAsync();
        var cats = await CategoryService.GetAllAsync();
        _categoryCount = cats.Count;
        _recent = await DesignService.GetRecentAsync(10);
    }
}
