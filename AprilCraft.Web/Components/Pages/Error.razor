@page "/Error"
@layout PublicLayout
@using System.Diagnostics

<PageTitle>Error — AprilCraft</PageTitle>

<div class="ac-not-found-container">
    <div class="ac-not-found-content">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Style="font-size:4rem; margin-bottom:1rem;" />
        <h1 class="ac-not-found-title">An Unexpected Error Occurred</h1>
        <p class="ac-not-found-desc">
            We encountered an issue while processing your request. Please try refreshing or returning to our homepage.
        </p>

        @if (ShowRequestId)
        {
            <div class="ac-error-request-id my-4">
                <MudText Typo="Typo.caption" Style="opacity:0.7;">Request ID: <code>@RequestId</code></MudText>
            </div>
        }

        <div class="ac-not-found-actions mt-6">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Href="/" StartIcon="@Icons.Material.Filled.Home">
                Return Home
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" Href="/gallery" StartIcon="@Icons.Material.Filled.Palette">
                View Gallery
            </MudButton>
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
