@page "/contact"
@layout PublicLayout
@inject ISnackbar Snackbar

<SeoTags Title="Contact Us — AprilCraft"
         Description="Get in touch with AprilCraft. Have a design project or brand overhaul in mind? Let's discuss and bring your creative vision to reality."
         Url="https://aprilcraft.com/contact" />

<div class="ac-page-hero">
    <h1 class="ac-brand-script">Get in Touch</h1>
    <p>Let's discuss your next project, explore new ideas, and build something remarkable together</p>
</div>

<div class="ac-section">
    <MudGrid Class="mb-12">
        <!-- Contact Info & Channels -->
        <MudItem xs="12" md="5">
            <MudText Typo="Typo.h5" Class="ac-brand-script mb-3" Style="color:var(--ac-accent)">Let's Collaborate</MudText>
            <MudText Typo="Typo.body1" Style="opacity:0.85; line-height:1.8;" Class="mb-6">
                Whether you need a full brand identity from scratch, packaging design for your next product launch, or refined marketing graphics, we'd love to hear from you.
            </MudText>

            <div class="ac-contact-methods">
                <div class="ac-contact-method-card">
                    <div class="ac-contact-method-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Email" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Direct Email</MudText>
                        <MudLink Href="mailto:hello@aprilcraft.com" Style="color:var(--ac-accent)">hello@aprilcraft.com</MudLink>
                    </div>
                </div>

                <div class="ac-contact-method-card">
                    <div class="ac-contact-method-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Response Time</MudText>
                        <MudText Typo="Typo.body2" Style="opacity:0.8;">Usually within 24–48 business hours</MudText>
                    </div>
                </div>

                <div class="ac-contact-method-card">
                    <div class="ac-contact-method-icon">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" />
                    </div>
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight:700;">Location & Availability</MudText>
                        <MudText Typo="Typo.body2" Style="opacity:0.8;">Worldwide Remote & Studio Sessions</MudText>
                    </div>
                </div>
            </div>
        </MudItem>

        <!-- Form -->
        <MudItem xs="12" md="7">
            @if (_sent)
            {
                <MudPaper Class="pa-8 text-center" Elevation="2" Style="border-radius:var(--ac-radius); border: 1px solid var(--ac-border);">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Style="font-size:4rem;" />
                    <MudText Typo="Typo.h5" Class="mt-3 mb-2 font-weight-bold">Message Received!</MudText>
                    <MudText Typo="Typo.body1" Style="opacity:0.85;" Class="mb-6">
                        Thank you for reaching out. We have received your inquiry and will be in touch with you shortly.
                    </MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="ResetForm" StartIcon="@Icons.Material.Filled.Send">
                        Send Another Message
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <MudPaper Class="pa-6" Elevation="2" Style="border-radius:var(--ac-radius); border: 1px solid var(--ac-border);">
                    <MudForm @ref="_form">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Project Details</MudText>
                        
                        <div class="mb-4">
                            <MudText Typo="Typo.caption" Style="color:var(--ac-text-muted); display:block; margin-bottom:6px;">Interested Services</MudText>
                            <MudChipSet T="string" @bind-SelectedValues="_selectedServices" SelectionMode="SelectionMode.MultiSelection" CheckMark="true">
                                <MudChip T="string" Value="@("Brand Identity")" Color="Color.Primary" Variant="Variant.Outlined">Brand Identity</MudChip>
                                <MudChip T="string" Value="@("Logo Design")" Color="Color.Primary" Variant="Variant.Outlined">Logo Design</MudChip>
                                <MudChip T="string" Value="@("Packaging & Print")" Color="Color.Primary" Variant="Variant.Outlined">Packaging & Print</MudChip>
                                <MudChip T="string" Value="@("Marketing Assets")" Color="Color.Primary" Variant="Variant.Outlined">Marketing Assets</MudChip>
                            </MudChipSet>
                        </div>

                        <MudGrid>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_name" Label="Your Name" Variant="Variant.Outlined"
                                              Required="true" RequiredError="Name is required." Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudTextField @bind-Value="_email" Label="Email Address" Variant="Variant.Outlined"
                                              Required="true" RequiredError="Valid email is required."
                                              InputType="InputType.Email" Margin="Margin.Dense" />
                            </MudItem>
                        </MudGrid>

                        <MudTextField @bind-Value="_subject" Label="Subject / Project Title" Variant="Variant.Outlined"
                                      Class="mt-4" Margin="Margin.Dense" />

                        <MudTextField @bind-Value="_message" Label="Tell us about your project or vision" Variant="Variant.Outlined"
                                      Required="true" RequiredError="Please share details about your request."
                                      Lines="5" Class="mt-4 mb-4" />

                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   Size="Size.Large" Disabled="_submitting"
                                   OnClick="SubmitAsync" StartIcon="@(_submitting ? null : Icons.Material.Filled.Send)">
                            @if (_submitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Sending Message…</span>
                            }
                            else
                            {
                                <span>Send Inquiry</span>
                            }
                        </MudButton>
                    </MudForm>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>

    <!-- FAQ Accordion -->
    <div class="ac-section-header mt-12">
        <h2 class="ac-section-title ac-brand-script">Frequently Asked Questions</h2>
        <p class="ac-section-sub">Quick answers to common questions about our design process</p>
    </div>

    <div class="ac-faq-container" style="max-width:840px; margin:0 auto;">
        <MudExpansionPanels MultiExpansion="false" Elevation="1" Style="border-radius:var(--ac-radius);">
            <MudExpansionPanel Text="What is your typical project timeline?">
                Timelines depend on project scope. Brand identity systems and logo packages generally take 1–3 weeks from discovery through final file delivery, with intermediate milestone reviews.
            </MudExpansionPanel>
            <MudExpansionPanel Text="What file formats do you deliver?">
                We deliver print-ready vector files (.AI, .EPS, .PDF, .SVG) as well as high-resolution raster formats (.PNG with transparent background, .WebP, .JPG) along with full usage instructions.
            </MudExpansionPanel>
            <MudExpansionPanel Text="Can I request revisions during the design process?">
                Absolutely. Every project includes structured revision rounds so we can iterate on concepts, refine typography, colors, and compositions until the result is perfect.
            </MudExpansionPanel>
            <MudExpansionPanel Text="How do I get started?">
                Simply fill out the inquiry form above or email us at <a href="mailto:hello@aprilcraft.com">hello@aprilcraft.com</a> with an overview of what you're looking to create!
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>
</div>

@code {
    private MudForm _form = default!;
    private string _name = "";
    private string _email = "";
    private string _subject = "";
    private string _message = "";
    private IReadOnlyCollection<string> _selectedServices = new List<string>();
    private bool _sent;
    private bool _submitting;

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (_form.IsValid)
        {
            _submitting = true;
            await Task.Delay(600); // Simulate smooth submit feedback
            _sent = true;
            _submitting = false;
            Snackbar.Add("Inquiry sent successfully!", Severity.Success);
        }
    }

    private void ResetForm()
    {
        _sent = false;
        _name = "";
        _email = "";
        _subject = "";
        _message = "";
        _selectedServices = new List<string>();
    }
}
