@* Full-screen lightbox overlay for viewing a design's variants *@
@using AprilCraft.Web.Data.Models
@using Microsoft.AspNetCore.Components.Web

@if (_open && Design != null)
{
    <div class="ac-lightbox" @onclick="Close" @onkeydown="HandleKeyDown">
        <div class="ac-lightbox-panel" role="dialog" aria-modal="true" aria-labelledby="lightbox-title" tabindex="0" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
            <div class="ac-lightbox-header">
                <div>
                    <h2 id="lightbox-title" class="ac-lightbox-title">@Design.Title</h2>
                    <span class="ac-lightbox-cat">@Design.Category?.Name</span>
                </div>
                <button type="button" class="ac-lightbox-close" @onclick="Close" aria-label="Close dialog">
                    <MudIcon Icon="@Icons.Material.Filled.Close" />
                </button>
            </div>

            <div class="ac-lightbox-body">
                <!-- Main image -->
                <div class="ac-lightbox-main">
                    @if (_activeVariant != null)
                    {
                        <img src="@_activeVariant.ImagePath" alt="@_activeVariant.Title"
                             class="ac-lightbox-img" />
                        @if (_activeVariant.IsClientSelected)
                        {
                            <span class="ac-lightbox-selected-badge">Client Selected</span>
                        }
                    }
                </div>
                <!-- Variant strip -->
                @if (Design.Variants.Count > 1)
                {
                    <div class="ac-lightbox-thumbs">
                        @foreach (var v in Design.Variants.OrderBy(x => x.SortOrder))
                        {
                            <button type="button"
                                    class="ac-lightbox-thumb @(_activeVariant?.Id == v.Id ? "active" : "")"
                                    @onclick="() => SelectVariant(v)"
                                    aria-label="@($"View variant {v.Title}")"
                                    aria-pressed="@(_activeVariant?.Id == v.Id)">
                                <img src="@v.ThumbnailPath" alt="@v.Title" />
                                @if (v.IsClientSelected)
                                {
                                    <span class="ac-thumb-check"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /></span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Info panel -->
            <div class="ac-lightbox-info">
                @if (!string.IsNullOrEmpty(Design.Description))
                {
                    <p class="ac-lightbox-desc">@Design.Description</p>
                }
                <div class="ac-lightbox-meta">
                    @if (!string.IsNullOrEmpty(Design.ClientName))
                    {
                        <span><MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" /> @Design.ClientName</span>
                    }
                    <span><MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Size="Size.Small" /> @Design.DesignDate.ToString("MMM yyyy")</span>
                </div>
                @if (Design.DesignTags.Any())
                {
                    <div class="ac-card-tags">
                        @foreach (var dt in Design.DesignTags)
                        {
                            <span class="ac-tag">@dt.Tag?.Name</span>
                        }
                    </div>
                }
                @if (Design.ClientFeedbacks.Any(f => f.IsPublic))
                {
                    <div class="ac-lightbox-feedbacks">
                        <h4>Client Feedback</h4>
                        @foreach (var fb in Design.ClientFeedbacks.Where(f => f.IsPublic).Take(2))
                        {
                            <div class="ac-feedback-item">
                                <div class="ac-feedback-stars">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <MudIcon Icon="@(i < fb.Rating ? Icons.Material.Filled.Star : Icons.Material.Outlined.Star)"
                                                 Size="Size.Small" Color="Color.Warning" />
                                    }
                                </div>
                                <p class="ac-feedback-text">@fb.Feedback</p>
                                <span class="ac-feedback-by">— @fb.ClientName</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private Design? Design;
    private DesignVariant? _activeVariant;

    public void Open(Design design)
    {
        Design = design;
        _activeVariant = design.PrimaryVariant;
        _open = true;
        StateHasChanged();
    }

    private void SelectVariant(DesignVariant variant)
    {
        _activeVariant = variant;
    }

    private void Close()
    {
        _open = false;
        StateHasChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Close();
        }
    }
}
