@page "/admin/designs"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IDesignService DesignService
@inject ICategoryService CategoryService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Designs — AprilCraft Admin</PageTitle>

<div class="ac-admin-page-header">
    <div>
        <MudText Typo="Typo.h4" Style="font-weight:700;">Design Portfolio</MudText>
        <MudText Typo="Typo.body2" Style="color:var(--ac-text-muted);">Manage all designs, variant images, resources, and client feedback</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" Href="/admin/designs/new">
        New Design
    </MudButton>
</div>

<div class="ac-toolbar mb-4">
    <MudTextField @bind-Value="_search" Placeholder="Search by title, client, or tag…" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Variant="Variant.Outlined"
                  DebounceInterval="300" OnDebounceIntervalElapsed="Reload" Clearable="true" OnClearButtonClick="ClearSearch"
                  Class="ac-search" Margin="Margin.Dense" />
    <MudSelect T="int?" Value="_activeCat" ValueChanged="SetCat"
               Variant="Variant.Outlined" Label="Category Filter" Margin="Margin.Dense" Class="ac-cat-select">
        <MudSelectItem T="int?" Value="@null">All Categories</MudSelectItem>
        @foreach (var cat in _categories)
        {
            <MudSelectItem T="int?" Value="@cat.Id">@cat.Name</MudSelectItem>
        }
    </MudSelect>
</div>

<MudTable Items="_designs" Hover="true" Dense="true" Striped="true" Loading="_loading" Elevation="2" Style="border-radius:var(--ac-radius); overflow:hidden;">
    <HeaderContent>
        <MudTh Style="width:70px;">Thumb</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Design, object>(x => x.Title)">Title</MudTableSortLabel></MudTh>
        <MudTh>Category</MudTh>
        <MudTh>Client</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<Design, object>(x => x.DesignDate)">Date</MudTableSortLabel></MudTh>
        <MudTh Style="text-align:center;">Featured</MudTh>
        <MudTh Style="text-align:right;">Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            @if (context.PrimaryVariant?.ThumbnailPath != null)
            {
                <img src="@context.PrimaryVariant.ThumbnailPath" class="ac-table-thumb" alt="thumbnail" />
            }
            else
            {
                <div class="ac-table-thumb-placeholder">
                    <MudIcon Icon="@Icons.Material.Outlined.Image" Size="Size.Small" Style="opacity:0.4;" />
                </div>
            }
        </MudTd>
        <MudTd>
            <strong>@context.Title</strong>
            @if (context.Variants.Count > 1)
            {
                <span class="ac-variant-count-badge">@context.Variants.Count variants</span>
            }
        </MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@(context.Category?.Name ?? "Unassigned")</MudChip>
        </MudTd>
        <MudTd>@(string.IsNullOrEmpty(context.ClientName) ? "—" : context.ClientName)</MudTd>
        <MudTd>@context.DesignDate.ToString("dd MMM yyyy")</MudTd>
        <MudTd Style="text-align:center;">
            @if (context.IsFeatured)
            {
                <MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Warning" Size="Size.Small" Title="Featured" />
            }
        </MudTd>
        <MudTd Style="text-align:right;">
            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                           Href="@($"/gallery?design={context.Id}")" Target="_blank" aria-label="View live in gallery" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                           Href="@($"/admin/designs/{context.Id}")" aria-label="Edit" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="() => ConfirmDelete(context)" aria-label="Delete" />
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <div class="pa-8 text-center" style="opacity:0.6;">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" />
            <MudText Typo="Typo.body1" Class="mt-2">No designs found.</MudText>
        </div>
    </NoRecordsContent>
</MudTable>

<!-- Delete confirm dialog -->
<MudDialog @bind-Visible="_deleteVisible">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">Confirm Deletion</MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Are you sure you want to delete <strong>@_deleteTarget?.Title</strong>?</MudText>
        <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-2" Style="display:block;">
            All associated variant images and thumbnails will also be permanently removed.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _deleteVisible = false">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="DeleteConfirmed">Delete Permanently</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<Design> _designs = new();
    private List<Category> _categories = new();
    private string? _search;
    private int? _activeCat;
    private bool _loading = true;
    private bool _deleteVisible;
    private Design? _deleteTarget;

    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetAllAsync();
        await Reload();
        _loading = false;
    }

    private async Task Reload() =>
        _designs = await DesignService.GetAllAsync(_activeCat, _search);

    private async Task ClearSearch()
    {
        _search = null;
        await Reload();
    }

    private async Task SetCat(int? catId)
    {
        _activeCat = catId;
        await Reload();
    }

    private void ConfirmDelete(Design d)
    {
        _deleteTarget = d;
        _deleteVisible = true;
    }

    private async Task DeleteConfirmed()
    {
        if (_deleteTarget == null) return;
        await DesignService.DeleteAsync(_deleteTarget.Id);
        Snackbar.Add($"\"{_deleteTarget.Title}\" deleted.", Severity.Success);
        _deleteVisible = false;
        await Reload();
    }
}
